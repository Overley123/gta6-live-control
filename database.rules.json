{
  "rules": {
    ".read": false,
    ".write": false,
    "scenes": {
      "$code": {
        ".read": "$code.matches(/^[A-HJ-NP-Z2-9]{12}$/)",
        ".write": "auth !== null && $code.matches(/^[A-HJ-NP-Z2-9]{12}$/) && newData.exists() && root.child('modCodes').child($code).exists() && root.child('modAccess').child($code).child(auth.uid).exists() && root.child('modAccess').child($code).child(auth.uid).val() === root.child('modCodes').child($code).val()",
        ".validate": "newData.hasChildren(['name', 'stats', 'clock', 'layout', 'visibility', 'colors', 'labels', 'createdAt', 'updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "stats": {
          ".validate": "newData.hasChildren(['day', 'missions', 'deaths'])",
          "day": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99999"
          },
          "missions": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
          },
          "deaths": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999"
          },
          "$other": {
            ".validate": false
          }
        },
        "clock": {
          ".validate": "newData.hasChildren(['totalBase', 'todayBase', 'running', 'todayDate', 'startedAt'])",
          "totalBase": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360000000"
          },
          "todayBase": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360000000"
          },
          "running": {
            ".validate": "newData.isBoolean()"
          },
          "todayDate": {
            ".validate": "newData.isString() && newData.val().length <= 15"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "layout": {
          ".validate": "newData.hasChildren(['x', 'y', 'scale', 'opacity'])",
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1900"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1040"
          },
          "scale": {
            ".validate": "newData.isNumber() && newData.val() >= 0.35 && newData.val() <= 2.4"
          },
          "opacity": {
            ".validate": "newData.isNumber() && newData.val() >= 0.1 && newData.val() <= 1"
          },
          "$other": {
            ".validate": false
          }
        },
        "visibility": {
          ".validate": "newData.hasChildren(['day','timer','missions','deaths'])",
          "day": {
            ".validate": "newData.isBoolean()"
          },
          "timer": {
            ".validate": "newData.isBoolean()"
          },
          "missions": {
            ".validate": "newData.isBoolean()"
          },
          "deaths": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "colors": {
          ".validate": "newData.hasChildren(['pink','cyan','amber','red'])",
          "pink": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "cyan": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "amber": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "red": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "labels": {
          ".validate": "newData.hasChildren(['day','time','missions','deaths'])",
          "day": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "time": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "missions": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "deaths": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "$other": {
            ".validate": false
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "modProtected": {
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      }
    },
    "modCodes": {
      "$code": {
        ".read": false,
        ".write": "auth !== null && $code.matches(/^[A-HJ-NP-Z2-9]{12}$/) && !data.exists() && newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/) && (!root.child('scenes').child($code).exists() || root.child('scenes').child($code).child('modProtected').val() !== true)",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
      }
    },
    "modAccess": {
      "$code": {
        "$uid": {
          ".read": false,
          ".write": "auth !== null && auth.uid === $uid && $code.matches(/^[A-HJ-NP-Z2-9]{12}$/) && root.child('modCodes').child($code).exists() && newData.isString() && newData.val() === root.child('modCodes').child($code).val()",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
        }
      }
    }
  }
}
